<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Колесо удачи</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
  :root {
    --bg: #0f1420;
    --card: #171d2b;
    --accent: #ffb020;
    --accent-dark: #b9790a;
    --text: #f5f6fa;
    --text-dim: #8b92a5;
    --green: #35c46a;
    --red: #e5484d;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 16px 40px;
    min-height: 100vh;
  }
  .top-bar {
    width: 100%;
    max-width: 360px;
    display: flex;
    justify-content: flex-end;
    margin-bottom: 14px;
  }
  .profile-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--card);
    border: 1px solid #262e42;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    cursor: pointer;
    color: var(--text);
  }
  .balance-card {
    width: 100%;
    max-width: 360px;
    background: var(--card);
    border-radius: 16px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    margin-bottom: 22px;
    border: 1px solid #262e42;
  }
  .balance-label {
    font-size: 13px;
    color: var(--text-dim);
    margin: 0 0 4px;
  }
  .balance-value {
    font-size: 26px;
    font-weight: 700;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .balance-value .star { color: var(--accent); font-size: 22px; }
  .wheel-wrap {
    position: relative;
    width: 300px;
    height: 300px;
    margin: 10px 0 28px;
  }
  .pointer {
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 14px solid transparent;
    border-right: 14px solid transparent;
    border-top: 22px solid var(--accent);
    z-index: 5;
    filter: drop-shadow(0 2px 2px rgba(0,0,0,0.4));
  }
  #wheel {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: block;
    border: 6px solid #262e42;
    transition: transform 4.5s cubic-bezier(0.12, 0.74, 0.14, 1);
    transform: rotate(0deg);
  }
  .hub {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    z-index: 4;
    box-shadow: 0 2px 8px rgba(0,0,0,0.5);
  }
  button#spinBtn {
    width: 100%;
    max-width: 300px;
    border: none;
    border-radius: 14px;
    padding: 16px;
    font-size: 17px;
    font-weight: 600;
    background: var(--accent);
    color: #1a1200;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.1s;
  }
  button#spinBtn:active { transform: scale(0.97); }
  button#spinBtn:disabled {
    background: #2a3142;
    color: var(--text-dim);
    cursor: default;
  }
  .timer {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-dim);
    text-align: center;
    min-height: 20px;
  }
  .result-banner {
    margin-top: 16px;
    background: rgba(53, 196, 106, 0.12);
    border: 1px solid rgba(53, 196, 106, 0.4);
    color: var(--green);
    padding: 10px 16px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.3s, transform 0.3s;
    text-align: center;
    max-width: 300px;
    width: 100%;
  }
  .result-banner.show {
    opacity: 1;
    transform: translateY(0);
  }
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    display: none;
    align-items: flex-start;
    justify-content: center;
    z-index: 20;
    padding: 70px 16px 16px;
  }
  .overlay.show { display: flex; }
  .profile-panel {
    width: 100%;
    max-width: 340px;
    background: var(--card);
    border-radius: 16px;
    border: 1px solid #262e42;
    padding: 18px 20px 10px;
  }
  .profile-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }
  .profile-panel-header h3 {
    font-size: 16px;
    margin: 0;
    font-weight: 600;
  }
  .close-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: #222a3a;
    color: var(--text);
    font-size: 16px;
    cursor: pointer;
  }
  .profile-balance {
    font-size: 30px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .profile-balance .star { color: var(--accent); }
  .history-title {
    font-size: 12px;
    color: var(--text-dim);
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .history-item {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    padding: 9px 0;
    border-bottom: 1px solid #222a3a;
    color: var(--text-dim);
  }
  .history-item .val { color: var(--text); font-weight: 600; }
  .history-empty {
    font-size: 13px;
    color: var(--text-dim);
    padding: 10px 0 16px;
    text-align: center;
  }
</style>
</head>
<body>

<div class="top-bar">
  <button class="profile-btn" id="profileBtn" aria-label="Профиль">👤</button>
</div>

<div class="balance-card">
  <div>
    <p class="balance-label">Баланс</p>
    <p class="balance-value"><span class="star">⭐</span><span id="balanceOut">0</span></p>
  </div>
</div>

<div class="wheel-wrap">
  <div class="pointer"></div>
  <svg id="wheel" viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg"></svg>
  <div class="hub">⭐</div>
</div>

<button id="spinBtn">Крутить колесо</button>
<div class="timer" id="timerOut"></div>
<div class="result-banner" id="resultBanner"></div>

<div class="overlay" id="overlay">
  <div class="profile-panel">
    <div class="profile-panel-header">
      <h3>Профиль</h3>
      <button class="close-btn" id="closeProfileBtn" aria-label="Закрыть">✕</button>
    </div>
    <div class="profile-balance"><span class="star">⭐</span><span id="profileBalanceOut">0</span></div>
    <p class="history-title">История вывода</p>
    <div id="historyList"></div>
  </div>
</div>

<script>
(function () {
  var tg = window.Telegram && window.Telegram.WebApp;
  if (tg) {
    tg.ready();
    tg.expand();
  }

  var PRIZES = [
    { value: 0.1, weight: 30, color: '#3a4256' },
    { value: 0.2, weight: 22, color: '#2f3b52' },
    { value: 0.5, weight: 20, color: '#3a4256' },
    { value: 1.0, weight: 14, color: '#2f3b52' },
    { value: 2.0, weight: 8,  color: '#4a3a1f' },
    { value: 3.0, weight: 4,  color: '#5a3a1a' },
    { value: 5.0, weight: 2,  color: '#b9790a' }
  ];

  var COOLDOWN_MS = 24 * 60 * 60 * 1000;
  var STORAGE_KEY = 'wheel_state_v1';

  function loadState() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return { balance: 0, lastSpin: 0, history: [] };
      var parsed = JSON.parse(raw);
      return {
        balance: typeof parsed.balance === 'number' ? parsed.balance : 0,
        lastSpin: typeof parsed.lastSpin === 'number' ? parsed.lastSpin : 0,
        history: Array.isArray(parsed.history) ? parsed.history : []
      };
    } catch (e) {
      return { balance: 0, lastSpin: 0, history: [] };
    }
  }

  function saveState(state) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch (e) {}
  }

  var state = loadState();

  var balanceOut = document.getElementById('balanceOut');
  var profileBalanceOut = document.getElementById('profileBalanceOut');
  var spinBtn = document.getElementById('spinBtn');
  var timerOut = document.getElementById('timerOut');
  var resultBanner = document.getElementById('resultBanner');
  var wheelEl = document.getElementById('wheel');
  var historyList = document.getElementById('historyList');
  var profileBtn = document.getElementById('profileBtn');
  var closeProfileBtn = document.getElementById('closeProfileBtn');
  var overlay = document.getElementById('overlay');

  function formatStars(n) {
    var rounded = Math.round(n * 10) / 10;
    return rounded.toFixed(rounded % 1 === 0 ? 0 : 1);
  }

  function renderBalance() {
    balanceOut.textContent = formatStars(state.balance);
    profileBalanceOut.textContent = formatStars(state.balance);
  }

  function renderHistory() {
    historyList.innerHTML = '';
    if (!state.history.length) {
      var empty = document.createElement('div');
      empty.className = 'history-empty';
      empty.textContent = 'Пока пусто — прокрути колесо';
      historyList.appendChild(empty);
      return;
    }
    state.history.slice(0, 20).forEach(function (h) {
      var row = document.createElement('div');
      row.className = 'history-item';
      var date = new Date(h.time);
      var dateStr = date.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit' }) +
        ' ' + date.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
      row.innerHTML = '<span>' + dateStr + '</span><span class="val">+' + formatStars(h.value) + ' ⭐</span>';
      historyList.appendChild(row);
    });
  }

  function buildWheel() {
    var total = PRIZES.reduce(function (sum, p) { return sum + p.weight; }, 0);
    var cx = 150, cy = 150, r = 144;
    var startAngle = 0;
    var svgParts = [];
    PRIZES.forEach(function (p) {
      var sliceAngle = (p.weight / total) * 360;
      var endAngle = startAngle + sliceAngle;
      var midAngle = startAngle + sliceAngle / 2;
      var largeArc = sliceAngle > 180 ? 1 : 0;

      function toXY(angleDeg, radius) {
        var rad = (angleDeg - 90) * Math.PI / 180;
        return [cx + radius * Math.cos(rad), cy + radius * Math.sin(rad)];
      }

      var p1 = toXY(startAngle, r);
      var p2 = toXY(endAngle, r);
      var path = 'M' + cx + ',' + cy +
        ' L' + p1[0].toFixed(2) + ',' + p1[1].toFixed(2) +
        ' A' + r + ',' + r + ' 0 ' + largeArc + ' 1 ' + p2[0].toFixed(2) + ',' + p2[1].toFixed(2) +
        ' Z';
      svgParts.push('<path d="' + path + '" fill="' + p.color + '" stroke="#0f1420" stroke-width="1"/>');

      var labelPos = toXY(midAngle, r * 0.66);
      svgParts.push(
        '<text x="' + labelPos[0].toFixed(2) + '" y="' + labelPos[1].toFixed(2) + '" ' +
        'fill="#f5f6fa" font-size="15" font-weight="700" text-anchor="middle" ' +
        'dominant-baseline="middle" transform="rotate(' + (midAngle).toFixed(2) + ' ' + labelPos[0].toFixed(2) + ' ' + labelPos[1].toFixed(2) + ')">' +
        formatStars(p.value) + '</text>'
      );

      startAngle = endAngle;
    });
    wheelEl.innerHTML = svgParts.join('');
  }

  function pickPrizeIndex() {
    var total = PRIZES.reduce(function (sum, p) { return sum + p.weight; }, 0);
    var r = Math.random() * total;
    var acc = 0;
    for (var i = 0; i < PRIZES.length; i++) {
      acc += PRIZES[i].weight;
      if (r <= acc) return i;
    }
    return PRIZES.length - 1;
  }

  function angleForIndex(index) {
    var total = PRIZES.reduce(function (sum, p) { return sum + p.weight; }, 0);
    var startAngle = 0;
    for (var i = 0; i < index; i++) {
      startAngle += (PRIZES[i].weight / total) * 360;
    }
    var sliceAngle = (PRIZES[index].weight / total) * 360;
    return startAngle + sliceAngle / 2;
  }

  var currentRotation = 0;
  var spinning = false;

  function formatRemaining(ms) {
    var totalSec = Math.ceil(ms / 1000);
    var h = Math.floor(totalSec / 3600);
    var m = Math.floor((totalSec % 3600) / 60);
    var s = totalSec % 60;
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    return pad(h) + ':' + pad(m) + ':' + pad(s);
  }

  var tickInterval = null;

  function updateCooldownUI() {
    var remaining = COOLDOWN_MS - (Date.now() - state.lastSpin);
    if (remaining <= 0) {
      spinBtn.disabled = false;
      spinBtn.textContent = 'Крутить колесо';
      timerOut.textContent = '';
      if (tickInterval) { clearInterval(tickInterval); tickInterval = null; }
      return;
    }
    spinBtn.disabled = true;
    spinBtn.textContent = 'Приходи позже';
    timerOut.textContent = 'Следующая попытка через ' + formatRemaining(remaining);
    if (!tickInterval) {
      tickInterval = setInterval(updateCooldownUI, 1000);
    }
  }

  function showResult(value) {
    resultBanner.textContent = '+' + formatStars(value) + ' ⭐ зачислено на баланс';
    resultBanner.classList.add('show');
    setTimeout(function () {
      resultBanner.classList.remove('show');
    }, 2600);
  }

  // Spinning sound, generated on the fly with Web Audio API (no external files needed).
  var audioCtx = null;
  var spinSoundNodes = null;

  function getAudioCtx() {
    if (!audioCtx) {
      var Ctx = window.AudioContext || window.webkitAudioContext;
      if (Ctx) audioCtx = new Ctx();
    }
    return audioCtx;
  }

  function playSpinSound(durationSec) {
    var ctx = getAudioCtx();
    if (!ctx) return;
    if (ctx.state === 'suspended') ctx.resume();

    var bufferSize = 2 * ctx.sampleRate;
    var noiseBuffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
    var output = noiseBuffer.getChannelData(0);
    for (var i = 0; i < bufferSize; i++) {
      output[i] = Math.random() * 2 - 1;
    }

    var noise = ctx.createBufferSource();
    noise.buffer = noiseBuffer;
    noise.loop = true;

    var filter = ctx.createBiquadFilter();
    filter.type = 'bandpass';
    filter.frequency.setValueAtTime(900, ctx.currentTime);
    filter.frequency.linearRampToValueAtTime(220, ctx.currentTime + durationSec);
    filter.Q.value = 1.2;

    var gain = ctx.createGain();
    gain.gain.setValueAtTime(0.0001, ctx.currentTime);
    gain.gain.linearRampToValueAtTime(0.22, ctx.currentTime + 0.3);
    gain.gain.setValueAtTime(0.22, ctx.currentTime + durationSec - 0.6);
    gain.gain.linearRampToValueAtTime(0.0001, ctx.currentTime + durationSec);

    noise.connect(filter);
    filter.connect(gain);
    gain.connect(ctx.destination);

    noise.start();
    noise.stop(ctx.currentTime + durationSec);

    spinSoundNodes = { noise: noise, gain: gain };
  }

  function playTickSound() {
    var ctx = getAudioCtx();
    if (!ctx) return;
    var osc = ctx.createOscillator();
    var gain = ctx.createGain();
    osc.type = 'square';
    osc.frequency.value = 1200;
    gain.gain.setValueAtTime(0.15, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + 0.08);
  }

  function spin() {
    if (spinning) return;
    var remaining = COOLDOWN_MS - (Date.now() - state.lastSpin);
    if (remaining > 0) return;

    spinning = true;
    spinBtn.disabled = true;

    var index = pickPrizeIndex();
    var targetSliceAngle = angleForIndex(index);
    var extraSpins = 5 + Math.floor(Math.random() * 2);
    var spinDuration = 4.5;
    var finalRotation = currentRotation + extraSpins * 360 + (360 - targetSliceAngle);

    wheelEl.style.transition = 'transform ' + spinDuration + 's cubic-bezier(0.12, 0.74, 0.14, 1)';
    wheelEl.style.transform = 'rotate(' + finalRotation + 'deg)';
    currentRotation = finalRotation % 360;

    playSpinSound(spinDuration);

    if (tg && tg.HapticFeedback) {
      tg.HapticFeedback.impactOccurred('light');
    }

    setTimeout(function () {
      var prizeValue = PRIZES[index].value;
      state.balance += prizeValue;
      state.lastSpin = Date.now();
      state.history.unshift({ value: prizeValue, time: state.lastSpin });
      state.history = state.history.slice(0, 50);
      saveState(state);
      renderBalance();
      renderHistory();
      showResult(prizeValue);
      playTickSound();
      spinning = false;
      updateCooldownUI();
      if (tg && tg.HapticFeedback) {
        tg.HapticFeedback.notificationOccurred('success');
      }
    }, spinDuration * 1000 + 100);
  }

  spinBtn.addEventListener('click', spin);
  profileBtn.addEventListener('click', function () {
    renderHistory();
    overlay.classList.add('show');
  });
  closeProfileBtn.addEventListener('click', function () {
    overlay.classList.remove('show');
  });
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) overlay.classList.remove('show');
  });

  buildWheel();
  renderBalance();
  updateCooldownUI();
})();
</script>

</body>
</html>
